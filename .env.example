# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
STEAM_WEB_API_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brovbro

# Public origin used for provider callbacks. Keep this aligned with the URL you
# open in the browser (and with your deployed origin outside local development).
BVB_PUBLIC_ORIGIN=http://localhost:3000

# Optional local SQLite path for the multiplayer prototype.
BVB_DEV_DB_PATH=.data/bro-v-bro.sqlite
